PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

REQUEST_TIMEOUT_MS=30000
CDSE_PROCESS_TIMEOUT_MS=60000
CDSE_STATISTICS_TIMEOUT_MS=120000
CDSE_RATE_LIMIT_RETRY_DELAY_SECONDS=180
CDSE_MAX_RETRIES=3
MAX_CATALOGUE_LIMIT=100

# Docker network values for terra-node-stack-master.
# Use localhost instead of service names when running npm run dev on the host.
MONGO_URI=mongodb://terra_service_user:supersecretpassword@terra-mongodb:27017/terra_db?authSource=terra_db
MONGO_DB_NAME=terra_db
MONGO_METADATA_COLLECTION=ingestion_metadata
S3_ENDPOINT=http://terra-minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=terra_service_user
S3_SECRET_KEY=supersecretpassword
S3_BUCKET=terra-bucket
S3_FORCE_PATH_STYLE=true

COPERNICUS_API_MODE=stac
COPERNICUS_STAC_BASE_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_SH_STATISTICS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
COPERNICUS_SH_CATALOG_URL=https://sh.dataspace.copernicus.eu/api/v1/catalog/1.0.0/search
CDSE_SH_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
COPERNICUS_ODATA_BASE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_ACCESS_TOKEN=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_BACKUP_CLIENT_ID=
CDSE_BACKUP_CLIENT_SECRET=
CDSE_FALLBACK_CLIENT_ID=
CDSE_FALLBACK_CLIENT_SECRET=
CDSE_BACKUP_2_CLIENT_ID=
CDSE_BACKUP_2_CLIENT_SECRET=
CDSE_BACKUP_3_CLIENT_ID=
CDSE_BACKUP_3_CLIENT_SECRET=



