# Optional explicit collector environment file
# DATA_COLLECTION_ENV_FILE=

# MongoDB
MONGO_URI=mongodb://MONGO_USERNAME:URL_ENCODED_PASSWORD@terra-mongodb:27017/terra_db?authSource=admin

# MinIO
MINIO_ENDPOINT=http://terra-minio:9000
MINIO_ACCESS_KEY=MINIO_USERNAME
MINIO_SECRET_KEY=MINIO_PASSWORD
MINIO_BUCKET_NAME=terra-bucket
MINIO_VERIFY_TLS=false

# Copernicus
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional fallback Copernicus credentials
# CDSE_BACKUP_CLIENT_ID=
# CDSE_BACKUP_CLIENT_SECRET=
# CDSE_BACKUP_2_CLIENT_ID=
# CDSE_BACKUP_2_CLIENT_SECRET=