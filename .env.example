# This template is committed to Git. Copy it to .env and provide real values.

# Optional explicit collector environment file.
# DATA_COLLECTION_ENV_FILE=

# MongoDB application connection. URL-encode the password when required.
MONGO_URI=mongodb://APP_USERNAME:URL_ENCODED_PASSWORD@MONGO_HOST:27017/DATABASE_NAME?authSource=AUTH_DATABASE

# MinIO S3 API application connection.
MINIO_ENDPOINT=https://MINIO_HOST
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_VERIFY_TLS=true

# Copernicus Data Space Ecosystem credentials.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional fallback Copernicus credentials. Numbered pairs are supported through 9.
# CDSE_BACKUP_CLIENT_ID=
# CDSE_BACKUP_CLIENT_SECRET=
# CDSE_BACKUP_2_CLIENT_ID=
# CDSE_BACKUP_2_CLIENT_SECRET=

# UC3: independent configuration for coastal-uc3-sentinel2. Inject into the process or use
# Docker Compose env_file; the UC3 Python entry point does not load .env itself.
UC3_INGEST_PROJECT_ID=YOUR_UC3_PROJECT_ID
UC3_INGEST_CDSE_CLIENT_ID=
UC3_INGEST_CDSE_CLIENT_SECRET=
UC3_INGEST_MONGODB_URI=mongodb://APP_USERNAME:URL_ENCODED_PASSWORD@MONGO_HOST:27017/UC3_TEST_DATABASE?authSource=AUTH_DATABASE
UC3_INGEST_MONGODB_DATABASE=uc3_ingestion_test
UC3_INGEST_MONGODB_COLLECTION_PREFIX=uc3_
UC3_INGEST_MINIO_ENDPOINT=https://MINIO_HOST
UC3_INGEST_MINIO_ACCESS_KEY=
UC3_INGEST_MINIO_SECRET_KEY=
UC3_INGEST_MINIO_BUCKET=uc3-ingestion-test
UC3_INGEST_MINIO_PREFIX=terra-uc3
UC3_INGEST_MINIO_REGION=us-east-1
UC3_INGEST_MINIO_SECURE=true
UC3_INGEST_MINIO_CERT_CHECK=true
UC3_INGEST_ALLOW_SERVING_NAMESPACE=false
# Optional registry override; otherwise the package's authorised export is used.
# UC3_INGEST_AOI_REGISTRY_FILE=/run/config/uc3_authorised_aois.json
# Optional persistent working directory; otherwise temporary files are removed.
# UC3_INGEST_WORK_DIR=/app/outputs/uc3
# Optional credential files or backup pairs (load overlays after main settings).
# UC3_INGEST_CDSE_CLIENT_ID_FILE=/run/secrets/uc3_cdse_id
# UC3_INGEST_CDSE_CLIENT_SECRET_FILE=/run/secrets/uc3_cdse_secret
# UC3_INGEST_CDSE_BACKUP_CLIENT_ID=
# UC3_INGEST_CDSE_BACKUP_CLIENT_SECRET=
# UC3_INGEST_CDSE_BACKUP_2_CLIENT_ID=
# UC3_INGEST_CDSE_BACKUP_2_CLIENT_SECRET=
# Optional provider URL overrides; normally use the package's CDSE defaults.
# UC3_INGEST_CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# UC3_INGEST_CDSE_CATALOG_URL=https://sh.dataspace.copernicus.eu/api/v1/catalog/1.0.0/search
# UC3_INGEST_CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
