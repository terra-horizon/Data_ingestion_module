# This template is committed to Git. Copy it to .env and provide real values.

# Optional explicit collector environment file.
# DATA_COLLECTION_ENV_FILE=

# MongoDB application connection. URL-encode the password when required.
MONGO_URI=mongodb://APP_USERNAME:URL_ENCODED_PASSWORD@MONGO_HOST:27017/DATABASE_NAME?authSource=AUTH_DATABASE

# MinIO S3 API application connection.
MINIO_ENDPOINT=https://MINIO_HOST
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_VERIFY_TLS=true

# Copernicus Data Space Ecosystem credentials.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional fallback Copernicus credentials. Numbered pairs are supported through 9.
# CDSE_BACKUP_CLIENT_ID=
# CDSE_BACKUP_CLIENT_SECRET=
# CDSE_BACKUP_2_CLIENT_ID=
# CDSE_BACKUP_2_CLIENT_SECRET=
