# Optional explicit collector environment file. When unset, the collector also
# searches for .env in the current directory and its own repository directories.
DATA_COLLECTION_ENV_FILE=

# Required for collector publication. Include the database name and authSource.
MONGO_URI=

# Required MinIO S3 API configuration.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_VERIFY_TLS=true
# MINIO_CA_BUNDLE=

# Required Copernicus Data Space Ecosystem credentials.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional fallback credential pairs. Numbered pairs are supported through 9.
# CDSE_BACKUP_CLIENT_ID=
# CDSE_BACKUP_CLIENT_SECRET=
# CDSE_BACKUP_2_CLIENT_ID=
# CDSE_BACKUP_2_CLIENT_SECRET=
