@localUrl = http://127.0.0.1:8000
@productionUrl = https://server.iprism.eu/data-ingestion
@baseUrl = {{localUrl}}
@jobId = af26fdb5b1a7432c8810cda57d5b98a2

### READ ONLY: retrieve a previously submitted satellite job
GET {{productionUrl}}/api/ingestion/satellite/jobs/{{jobId}}
Accept: application/json

### WRITES DATA: submits a real satellite job on the uth server
POST {{productionUrl}}/api/ingestion/run
Content-Type: application/json
Accept: application/json

{
  "run_job_id": "uc1-satellite-example-20261109-001",
  "triggered_at": "2026-11-09T09:00:00Z",
  "provider": "sentinel-2",
  "profile": "uc1-water-pollutants-collector",
  "aoi_id": "sperchios",
  "bbox": [22.433493, 38.837552, 22.569555, 38.894223],
  "sensor": "sentinel2",
  "mode": "auto",
  "history_start": "2016-01-01",
  "max_days_per_run": 1,
  "max_tiles_per_run": 1,
  "discovery_chunk_days": 31,
  "max_cloud_coverage": 30
}
