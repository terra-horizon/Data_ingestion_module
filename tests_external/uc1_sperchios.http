@localUrl = http://127.0.0.1:8000
@productionUrl = https://server.iprism.eu/data-ingestion
@baseUrl = {{localUrl}}

### WRITES DATA: UC1 Sperchios river ingestion (productionUrl targets production)
### Update run_job_id and triggered_at for each test. Adjust baseUrl for your service.
POST {{productionUrl}}/api/ingestion/run
Content-Type: application/json
Accept: application/json

{
  "run_job_id": "uc1-sperchios-river-test-001",
  "triggered_at": "2026-11-04T09:00:00Z",
  "provider": "sentinel-2",
  "profile": "uc1-sperchios-river",
  "aoi_id": "sperchios",
  "bbox": [22.433493, 38.837552, 22.569555, 38.894223]
}

